# Copy this file to ".env" and fill in the values from Firebase (see README.md).
# Leave them empty to use the app in "local only" mode (saved in your browser).
# One value per line, no quotes or commas needed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
